<?xml version="1.0" encoding="utf-8"?>
<!-- NRSuite stores captured credentials, keys, captures, and session data.
     Backups are disabled in the manifest; these exclusions are defense in depth. -->
<full-backup-content>
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
